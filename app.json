{
  "expo": {
    "name": "Mini Star Childcare",
    "slug": "ministar-childcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3da98a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ministar.childcare",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for QR code scanning and uploading photos",
        "NSLocationWhenInUseUsageDescription": "Used to verify authorized GPS pickup locations",
        "NSPhotoLibraryUsageDescription": "Used to select and upload child photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3da98a"
      },
      "package": "com.ministar.childcare",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3da98a",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mini Star to access your camera for QR code scanning."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Mini Star to access your location for authorized pickup verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mini Star to access your photo library."
        }
      ]
    ],
    "scheme": "ministar",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
